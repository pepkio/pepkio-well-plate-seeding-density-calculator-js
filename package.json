{
  "name": "pepkio-well-plate-seeding-density-calculator",
  "version": "0.1.0",
  "description": "Call the Pepkio Cell Seeding Density Calculator REST API from Node.js with typed ESM imports and a CLI.",
  "readme": "README_NPM.md",
  "license": "MIT",
  "author": "Pepkio Team",
  "homepage": "https://www.pepkio.com/tools/well-plate-seeding-density-calculator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-well-plate-seeding-density-calculator-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-well-plate-seeding-density-calculator-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "keywords": [
    "well-plate-seeding-density-calculator",
    "cell-seeding",
    "seeding-density",
    "hemocytometer",
    "cell-culture",
    "tissue-culture",
    "confluency",
    "viability",
    "6-well",
    "96-well",
    "384-well",
    "plate-format",
    "pepkio",
    "laboratory-calculator",
    "bioinformatics",
    "life-sciences",
    "typescript",
    "node",
    "rest-api",
    "scientific-computing",
    "transfection",
    "adherent-cells"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-well-plate-seeding-density-calculator": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run test/client.test.ts",
    "test:integration": "vitest run test/integration.test.ts",
    "test:all": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "undici": "^7.27.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dotenv": "^16.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.2"
  }
}
